<div class="contact-form contact-popup js-contact-popup bg-white" role="dialog" aria-modal="true" aria-labelledby="contact-popup-title" hidden>
    <div class="contact-popup-backdrop js-contact-popup-close" aria-hidden="true"></div>
    <div class="contact-popup-dialog a-fade-in-up">
        <div class="contact-popup-content d-flex flex-column gap-24">
            <div class="contact-popup-heading d-flex flex-column gap-32 align-items-center">
                <div class="contact-item-icon pp-proces-item-number a-bubble-pop js-contact-popup-icon" data-animate-delay="0.10">
                    <img src="{{check}}" alt="">
                </div>
                <p id="contact-popup-title" class="p-xl fw-bolder c-headline text-center mb-0">Otrzymaliśmy Twoją wiadomość!</p>
            </div>
            <p class="p-l fw-bolder c-secondary text-center mb-0">Skontaktujemy się z Tobą w ciągu 24h.</p>
            <p class="p-m c-body text-center mb-0">Potwierdzenie wysłania wiadomości otrzymasz<br class="d-none d-sm-block"> na podany przez Ciebie adres e-mail.</p>
            <div class="contact-popup-actions d-flex justify-content-center">
                <button type="button" class="c-btn c-btn-s c-btn-fill js-contact-popup-close">
                    <span>Ok</span>
                </button>
            </div>
        </div>
    </div>
</div>
