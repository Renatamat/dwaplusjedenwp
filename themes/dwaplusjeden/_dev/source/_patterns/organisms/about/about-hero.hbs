{{> organisms-header }}
<section class="about-header">
    <div class="about-header-bg">
        <img src="{{aboutheader}}" alt="">
    </div>
    <div class="about-header-wrapper">
        <div class="container position-relative">
            <div class="row">
                <div class="col-12">
                    {{> organisms-breadcrumb }} 
                </div>
            </div>
        </div>
        <div class="container position-relative mt-auto">
            <div class="row">
                <div class="col-12 col-lg-8 col-xxxl-6 mx-auto">
                    <div class="d-flex flex-column gap-8 align-items-center">
                        <h1 class="h5 fw-bolder c-white text-center a-about-header-title">2+1 Eksperci księgowości</h1>
                        <p class="p-m c-white text-center a-about-header-copy">Stawiamy na indywidualne podejście, nowoczesne narzędzia i ciągły rozwój kompetencji. Dbamy o to, by każdy klient czuł się bezpiecznie i miał pewność, że <strong>jego księgowość jest w dobrych rękach.</strong></p>
                    </div>
                </div>
            </div>
            <div class="row r-gap-24 mt-32 a-about-header-cards">
                <div class="col-md-6 col-xl-3 a-about-header-card">
                    <div class="about-header-card">
                        <div class="d-flex flex-column align-items-center gap-8">
                            <div class="h5 fw-lighter c-body d-flex">
                                <span class="a-about-counter" data-target="15">15</span>
                                <span class="a-about-counter-suffix">+</span>
                            </div>
                            <span class="p-s fw-bolder c-body">Lat na rynku</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3 a-about-header-card">
                    <div class="about-header-card">
                        <div class="d-flex flex-column align-items-center gap-8">
                            <div class="h5 fw-lighter c-body d-flex">
                                <span class="a-about-counter" data-target="200">200</span>
                                <span class="a-about-counter-suffix">+</span>
                            </div>
                            <span class="p-s fw-bolder c-body">Obsługiwanych firm</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3 a-about-header-card">
                    <div class="about-header-card">
                        <div class="d-flex flex-column align-items-center gap-8">
                            <div class="h5 fw-lighter c-body d-flex">
                                <span class="a-about-counter" data-target="98">98</span>
                                <span class="a-about-counter-suffix">%</span>
                            </div>
                            <span class="p-s fw-bolder c-body">Zadowolonych klientów</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-3 a-about-header-card">
                    <div class="about-header-card">
                        <div class="d-flex flex-column align-items-center gap-8">
                            <div class="h5 fw-lighter c-body d-flex">
                                <span class="a-about-counter" data-target="24">24</span>
                                <span class="a-about-counter-suffix">/7</span>
                            </div>
                            <span class="p-s fw-bolder c-body">Dostępność online</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</section>
