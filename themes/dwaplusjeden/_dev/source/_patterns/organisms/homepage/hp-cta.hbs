<section class="hp-cta pt-56 pb-56 pt-lg-96 pb-lg-96">
    <div class="container">
        <div class="row r-gap-24">
            <div class="col-lg-5 order-2 order-lg-1 d-flex align-items-center">
                <div class="d-flex flex-column gap-48">
                    <div class="d-flex flex-column gap-24 hp-cta-content">
                        <h2 class="h6 fw-bolder c-white a-slide-left">
                            Księgowość online
                        </h2>
                        <p class="p-m c-white a-slide-left" data-animate-delay="0.06">The body text should clarify your main intention. 
                            Why should people care about your product?
                            Use this space to clarify your product offering. 
                        </p>
                        <div class="d-flex flex-column gap-16">
                            <div class="d-flex gap-16 align-items-center a-slide-left" data-animate-delay="0.12">
                                <div class="hp-cta-list-icon">
                                    <svg class="i-sprite icon-16">
                                        <use href="/sprites/icons-16.svg#check"></use>
                                    </svg>
                                </div>
                                <span class="p-m c-white">Wystawiaj faktury w kilka sekund</span>
                            </div>
                            <div class="d-flex gap-16 align-items-center a-slide-left" data-animate-delay="0.18">
                                <div class="hp-cta-list-icon">
                                    <svg class="i-sprite icon-16">
                                        <use href="/sprites/icons-16.svg#check"></use>
                                    </svg>
                                </div>
                                <span class="p-m c-white">Przesyłaj dokumenty do księgowego online</span>
                            </div>
                            <div class="d-flex gap-16 align-items-center a-slide-left" data-animate-delay="0.24">
                                <div class="hp-cta-list-icon">
                                    <svg class="i-sprite icon-16">
                                        <use href="/sprites/icons-16.svg#check"></use>
                                    </svg>
                                </div>
                                <span class="p-m c-white">Monitoruj terminy płatności faktur</span>
                            </div>
                            <div class="d-flex gap-16 align-items-center a-slide-left" data-animate-delay="0.3">
                                <div class="hp-cta-list-icon">
                                    <svg class="i-sprite icon-16">
                                        <use href="/sprites/icons-16.svg#check"></use>
                                    </svg>
                                </div>
                                <span class="p-m c-white">Śledź finanse firmy w czasie rzeczywistym</span>
                            </div>
                        </div>
                        
                    </div>
                    <a href="#" class="c-btn c-btn-s c-btn-fill">
                        <span>Wypróbuj za darmo</span>
                    </a>
                </div>
            </div>
            <div class="offset-lg-1 col-lg-6 order-1 order-lg-2">
                <div class="position-relative">
                    <img src="{{cta}}" alt="">
                    <div class="hp-hero-slider-message a-bubble-pop" data-animate-delay="0.12" data-animate-start="top 82%">
                        <div class="hp-hero-slider-message-wrapper">
                            <div class="d-flex flex-column gap-16">
                                <p class="p-s">
                                    Ten wydatek możemy wrzucić w koszty – zapłaci Pani mniejszy podatek.
                                </p>
                                <div class="d-flex flex-column">
                                    <span class="p-s fw-bolder c-body">
                                        Iwona
                                    </span>
                                    <span class="p-overline c-black">TWOJA KSIĘGOWA</span>
                                </div>
                            </div>
                        </div>
                        <div class="hero-slider-avatar">
                            {{> molecules-avatar }}
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</section>
